{
    "name": "perceptron-systems/laravel-email-cloak",
    "description": "Obfuscation email Laravel — 0 JS, route mailto signée, friendly Core Web Vitals.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "email", "obfuscation", "cloak", "anti-spam", "blade", "no-js"],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/encryption": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PerceptronSystems\\EmailCloak\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PerceptronSystems\\EmailCloak\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PerceptronSystems\\EmailCloak\\EmailCloakServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
